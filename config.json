      {
        "source_name": "Avalanche_ORG",
        "month": "*",
        "day": "*",
        "hour": 3,
        "minute": 15,
        "timezone": "Europe/Warsaw",
        "name": "download_Avalanche_ORG"
      },
      {
        "source_name": "IBTrACS",
        "month": "*",
        "day": "*",
        "hour": 3,
        "minute": 30,
        "timezone": "Europe/Warsaw",
        "name": "download_IBTrACS"
      },
      {
        "source_name": "USGS_Volcano",
        "month": "*",
        "day": "*",
        "hour": 3,
        "minute": 45,
        "timezone": "Europe/Warsaw",
        "name": "download_USGS_Volcano"
