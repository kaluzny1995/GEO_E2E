{
  "dag": {
    "dag_id": "geo_pipeline",
    "start_date": "2026-01-01",
    "timezone": "Europe/Warsaw",
    "catchup": false,
    "max_active_runs": 1,
    "tags": ["geo", "e2e"],
    "retries": 0,
    "execution_timeout_minutes": 30,
    "union_source": "Union",
    "pools": {
      "download": "download",
      "ingestion": "etl",
      "data_quality": "etl",
      "single_etl": "etl",
      "view": "etl"
    },
    "pool_slots": {
      "download": 3,
      "etl": 2
    }
  },
  "job": {
    "download": {
      "folder_name": "GEO_Download",
      "python_script": "run_download.py",
      "conda_env": "geo_download_311"
    },
    "ingestion": {
      "folder_name": "GEO_ETL",
      "python_script": "run_etl.py",
      "conda_env": "geo_etl_311"
    },
    "data_quality": {
      "folder_name": "GEO_ETL",
      "python_script": "run_etl.py",
      "conda_env": "geo_etl_311"
    },
    "single_etl": {
      "folder_name": "GEO_ETL",
      "python_script": "run_etl.py",
      "conda_env": "geo_etl_311"
    },
    "view": {
      "folder_name": "GEO_ETL",
      "python_script": "run_etl.py",
      "conda_env": "geo_etl_311"
    }
  }
}
