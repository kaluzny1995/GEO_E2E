{
  "celery_app": {
    "name": "geo_download_app",
    "username": "geo_mq_admin",
    "password": "geo_mq_admin",
    "host": "localhost",
    "port": 5673,
    "celery_settings": {
      "task_time_limit": 1800,
      "task_soft_time_limit": 1500,
      "worker_max_tasks_per_child": 20,
      "worker_max_memory_per_child": 400000,
      "worker_prefetch_multiplier": 1,
      "task_acks_late": true
    },
    "tasks": [
      {
        "source_name": "USGS_Earthquake",
        "month": "*",
        "day": "*",
        "hour": 2,
        "minute": 0,
        "timezone": "Europe/Warsaw",
        "name": "geo_e2e_USGS_Earthquake"
      },
      {
        "source_name": "GDACS",
        "month": "*",
        "day": "*",
        "hour": 2,
        "minute": 15,
        "timezone": "Europe/Warsaw",
        "name": "geo_e2e_GDACS"
      },
      {
        "source_name": "EONET",
        "month": "*",
        "day": "*",
        "hour": 2,
        "minute": 30,
        "timezone": "Europe/Warsaw",
        "name": "geo_e2e_EONET"
      },
      {
        "source_name": "OpenMeteo_Flood",
        "month": "*",
        "day": "*",
        "hour": 2,
        "minute": 45,
        "timezone": "Europe/Warsaw",
        "name": "geo_e2e_OpenMeteo_Flood"
      },
      {
        "source_name": "USGS_NWIS",
        "month": "*",
        "day": "*",
        "hour": 3,
        "minute": 0,
        "timezone": "Europe/Warsaw",
        "name": "geo_e2e_USGS_NWIS"
      },
      {
        "source_name": "Avalanche_ORG",
        "month": "*",
        "day": "*",
        "hour": 3,
        "minute": 15,
        "timezone": "Europe/Warsaw",
        "name": "geo_e2e_Avalanche_ORG"
      },
      {
        "source_name": "IBTrACS",
        "month": "*",
        "day": "*",
        "hour": 3,
        "minute": 30,
        "timezone": "Europe/Warsaw",
        "name": "geo_e2e_IBTrACS"
      },
      {
        "source_name": "USGS_Volcano",
        "month": "*",
        "day": "*",
        "hour": 3,
        "minute": 45,
        "timezone": "Europe/Warsaw",
        "name": "geo_e2e_USGS_Volcano"
      },
      {
        "source_name": "NIFC",
        "month": "*",
        "day": "*",
        "hour": 4,
        "minute": 0,
        "timezone": "Europe/Warsaw",
        "name": "geo_e2e_NIFC"
      }
    ]
  },
  "job": {
    "download": {
      "folder_name": "GEO_Download",
      "python_script": "run_download.py",
      "conda_env": "geo_download_311"
    },
    "ingestion": {
      "folder_name": "GEO_ETL",
      "python_script": "run_etl.py",
      "conda_env": "geo_etl_311"
    },
    "data_quality": {
      "folder_name": "GEO_ETL",
      "python_script": "run_etl.py",
      "conda_env": "geo_etl_311"
    },
    "single_etl": {
      "folder_name": "GEO_ETL",
      "python_script": "run_etl.py",
      "conda_env": "geo_etl_311"
    }
  }
}
