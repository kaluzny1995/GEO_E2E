{
  "celery_app": {
    "name": "geo_download_app",
    "username": "mq_admin",
    "password": "mq_admin",
    "host": "localhost",
    "port": 5672,
    "celery_settings": {
      "task_time_limit": 600,
      "task_soft_time_limit": 480,
      "worker_max_tasks_per_child": 20,
      "worker_max_memory_per_child": 400000,
      "worker_prefetch_multiplier": 1,
      "task_acks_late": true
    },
    "tasks": [
      {
        "source_name": "USGS_Earthquake",
        "month": "*",
        "day": "*",
        "hour": 2,
        "minute": 0,
        "timezone": "Europe/Warsaw",
        "name": "download_USGS_Earthquake"
      },
      {
        "source_name": "GDACS",
        "month": "*",
        "day": "*",
        "hour": 2,
        "minute": 15,
        "timezone": "Europe/Warsaw",
        "name": "download_GDACS"
      },
      {
        "source_name": "EONET",
        "month": "*",
        "day": "*",
        "hour": 2,
        "minute": 30,
        "timezone": "Europe/Warsaw",
        "name": "download_EONET"
      },
      {
        "source_name": "OpenMeteo_Flood",
        "month": "*",
        "day": "*",
        "hour": 2,
        "minute": 45,
        "timezone": "Europe/Warsaw",
        "name": "download_OpenMeteo_Flood"
      },
      {
        "source_name": "USGS_NWIS",
        "month": "*",
        "day": "*",
        "hour": 3,
        "minute": 0,
        "timezone": "Europe/Warsaw",
        "name": "download_USGS_NWIS"
