# Machine-specific values (paths, uid, Airflow UI login, Supabase credentials).
# `./setup.sh` writes .env.local (git-ignored) with these values detected from this checkout;
# this template is the manual fallback: `cp .env.example .env.local` and adjust the values.

# Parent dir of the sibling projects (GEO_Download, GEO_E2E, GEO_ETL)
GEO_ROOT=/absolute/path/to/GeographicData
# Data folder shared with the Spark containers (read-only mount)
GEO_DATA_DIR=/absolute/path/to/GeographicData/GEO_Download/data
# Conda installation on the host (bind-mounted into the Airflow containers)
CONDA_ROOT=/absolute/path/to/anaconda3
# Host uid of your user so containers can write to bind mounts: id -u
AIRFLOW_UID=1000

# Airflow web UI login (airflow-init creates this admin user on docker compose up)
_AIRFLOW_WWW_USER_USERNAME=<airflow_username>
_AIRFLOW_WWW_USER_PASSWORD=<airflow_password>

# Supabase PostgreSQL — Airflow's metadata DB (no local Postgres container). This is where the
# Supabase setup lives for the whole pipeline: ./setup.sh writes these five values into this
# file AND into ../GEO_ETL/.env and ../GEO_API/.env (both siblings read them from there). Take them from the Supabase
# dashboard → Project → Connect → Connection pooling → Transaction pooler (full walkthrough:
# docs/configuration.md → "Supabase metadata DB").
SUPABASE_DB_USER=postgres.<YOUR-PROJECT-REF>
SUPABASE_DB_PASSWORD=<YOUR-PASSWORD>
SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres

# Schema of that database holding Airflow's metadata tables (created by airflow-init before
# the migration runs; docker-compose.yaml pins the connection's search_path to it)
AIRFLOW_DB_SCHEMA=geo_airflow
