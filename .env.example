# Docker Compose environment for the GEO E2E stack.
# `docker compose` auto-loads this file when it is named `.env` in this directory.
#
# REQUIRED BEFORE `docker compose up`:
#   the five SUPABASE_DB_* values below.
# Airflow has working defaults (airflow_admin / airflow_admin); override them if needed.
#
# Manual fallback: `cp .env.example .env` and fill in the values.
# `./setup.sh` can also generate .env and imports existing Supabase credentials from
# ../GEO_ETL/.env or ../GEO_API/.env when present.

# Host data folder bind-mounted into Airflow and Spark as /opt/geo/GEO_Download/data.
# This is the single source of truth for downloaded CSV files and reference lookups.
# ./setup.sh writes an absolute path; the relative path below is resolved from this file's
# directory by Docker Compose.
GEO_DATA_DIR=../GEO_Download/data

# Host UID the Airflow containers run as, so downloads write files owned by you.
# ./setup.sh detects it automatically; 1000 is a common Linux default.
AIRFLOW_UID=1000

# Airflow web UI login (airflow-init creates this admin user on startup).
_AIRFLOW_WWW_USER_USERNAME=airflow_admin
_AIRFLOW_WWW_USER_PASSWORD=airflow_admin

# Supabase PostgreSQL — Airflow's metadata DB, GEO_ETL's JDBC writes and GEO_API's queries.
# Supabase dashboard → Project → Connect → Connection pooling → Transaction pooler.
SUPABASE_DB_USER=postgres.<YOUR-PROJECT-REF>
SUPABASE_DB_PASSWORD=<YOUR-PASSWORD>
SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres

# Schema holding Airflow's metadata tables (created by airflow-init before the migration).
AIRFLOW_DB_SCHEMA=geo_airflow

# Optional: the API URL compiled into the React app. It must be reachable from the user's
# browser, so keep localhost when running the whole stack on one machine.
VITE_API_BASE=http://localhost:8000

# Optional host ports (defaults shown) — change if a port is already in use.
# AIRFLOW_HOST_PORT=8090
# SPARK_MASTER_PORT_HOST=7078
# SPARK_MASTER_UI_HOST_PORT=8083
# SPARK_WORKER_1_UI_HOST_PORT=8084
# SPARK_WORKER_2_UI_HOST_PORT=8085
# GEO_API_HOST_PORT=8000
# GEO_APP_HOST_PORT=3000

# ---------------------------------------------------------------------------
# Resource limits (optional; the defaults below are what Docker Compose uses)
# ---------------------------------------------------------------------------
# Every service has a hard cgroup memory limit. memswap_limit is set equal to
# mem_limit, so a runaway task is OOM-killed inside its container instead of
# pushing the host into swap thrash. Lower these on a laptop with less free RAM.
AIRFLOW_MEM_LIMIT=1g
AIRFLOW_SCHEDULER_MEM_LIMIT=4g
AIRFLOW_INIT_MEM_LIMIT=2g
AIRFLOW_API_MEM_LIMIT=1g
AIRFLOW_DAG_PROCESSOR_MEM_LIMIT=1g
SPARK_MASTER_MEM_LIMIT=1g
SPARK_WORKER_MEM_LIMIT=3g
GEO_API_MEM_LIMIT=1g
GEO_APP_MEM_LIMIT=128m

# LocalExecutor worker processes (Airflow's default is 32) and per-DAG caps.
# The download pool has 3 slots and the etl pool 2, so 8 workers is enough.
AIRFLOW_PARALLELISM=8
AIRFLOW_MAX_ACTIVE_TASKS_PER_DAG=6
AIRFLOW_MAX_ACTIVE_RUNS_PER_DAG=1

# Spark workers and drivers. Keep the sum of both workers and the scheduler's
# drivers well below the host's free RAM.
SPARK_WORKER_MEMORY=2g
SPARK_WORKER_CORES=2
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g
SPARK_EXECUTOR_CORES=1
SPARK_SHUFFLE_PARTITIONS=8
SPARK_MAX_RESULT_SIZE=256m
